{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/agent/*": ["../src/agent/*"],
      "@/broker/*": ["../src/broker/*"],
      "@/db/*": ["../src/db/*"],
      "@/eval/*": ["../src/eval/*"],
      "@/lib/*": ["./src/lib/*", "../src/lib/*"],
      "@/parsing/*": ["../src/parsing/*"],
      "@/trades/*": ["../src/trades/*"],
      "@/*": ["./src/*"],
      "@src/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "vite-env.d.ts"],
  "exclude": ["node_modules"]
}
