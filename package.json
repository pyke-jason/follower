{
  "name": "trade-follower",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "local-api": "tsx watch src/local-api/server.ts",
    "web": "cd web && npm run dev",
    "backtest": "tsx src/backtest/launch.ts",
    "secrets:import": "tsx src/lib/secrets/manage.ts import",
    "secrets:set": "tsx src/lib/secrets/manage.ts set",
    "secrets:get": "tsx src/lib/secrets/manage.ts get",
    "secrets:list": "tsx src/lib/secrets/manage.ts list",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "cd web && npm run build",
    "gateway": "~/ibc/gatewaystartmacos.sh -inline",
    "up": "tsx scripts/dev-up.ts",
    "up:ui": "tsx scripts/dev-up.ts --no-backend",
    "up:full": "tsx scripts/dev-up.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@hono/node-server": "^1.19.9",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "openai": "^6.22.0",
    "playwright": "^1.58.2",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.9",
    "fast-check": "^4.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
