{
  "name": "trade-follower",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "local-api": "tsx watch src/local-api/server.ts",
    "web": "cd web && pnpm dev",
    "backtest": "tsx src/backtest/launch.ts",
    "classify": "tsx src/classify/launch.ts",
    "export:no-badge-trade-corpus": "tsx scripts/export-no-badge-trade-corpus.ts",
    "secrets:import": "tsx src/lib/secrets/manage.ts import",
    "secrets:set": "tsx src/lib/secrets/manage.ts set",
    "secrets:get": "tsx src/lib/secrets/manage.ts get",
    "secrets:list": "tsx src/lib/secrets/manage.ts list",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "build": "cd web && pnpm build",
    "gateway": "~/ibc/gatewaystartmacos.sh -inline",
    "up": "tsx scripts/dev-up.ts",
    "up:ui": "tsx scripts/dev-up.ts --no-backend",
    "up:full": "tsx scripts/dev-up.ts"
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.83",
    "@anthropic-ai/claude-agent-sdk": "^0.2.111",
    "@hono/node-server": "^1.19.9",
    "ai": "^6.0.167",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "imapflow": "^1.2.18",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.9",
    "fast-check": "^4.5.3",
    "knip": "^6.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
