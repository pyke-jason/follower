<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradefollower.agent</string>

  <!-- Use the explicit NVM node binary so launchd's minimal PATH doesn't matter. -->
  <!-- Update the node version path if you upgrade Node via nvm. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jason/.nvm/versions/node/v22.22.1/bin/node</string>
    <string>/Users/jason/Workspace/trade-follower-3/node_modules/.bin/tsx</string>
    <string>src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jason/Workspace/trade-follower-3</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- NVM bin first so any child processes (tsx, scripts) also find the right node. -->
    <key>PATH</key>
    <string>/Users/jason/.nvm/versions/node/v22.22.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/jason</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on crash (non-zero exit) only.
       launchctl stop sends SIGTERM → clean exit (0) → no restart. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jason/Workspace/trade-follower-3/data/logs/agent-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jason/Workspace/trade-follower-3/data/logs/agent-stderr.log</string>

  <!-- 30s prevents a rapid crash loop (e.g. DB down at boot) from hammering the broker. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
