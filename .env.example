# ─── Core ────────────────────────────────────────────────────────────
# DATABASE_URL=file:data/trade-follower.db
# LOG_LEVEL=info                        # debug | info | warn | error
# LOCAL_API_PORT=4000
# SECRET_PROVIDER=keychain              # keychain | env

# ─── Ingestion (OneOption) ───────────────────────────────────────────
# LIVE_INGESTION_ENABLED=1              # set 0 to disable
# CHAT_URL=https://app.oneoption.com/chat
# ONE_OP_EMAIL=
# ONE_OP_PASS=
# HEADLESS=false
# USER_DATA_DIR=                        # defaults to data/browser-session

# ─── IBKR Live ───────────────────────────────────────────────────────
# IBKR_LIVE_ACCOUNT_ID=
# IBKR_LIVE_SIDECAR_URL=http://localhost:8090/api
# IBKR_LIVE_SIDECAR_WS=ws://localhost:8090/events

# ─── IBKR Paper ──────────────────────────────────────────────────────
# IBKR_PAPER_ACCOUNT_ID=
# IBKR_PAPER_SIDECAR_URL=http://localhost:8090/api
# IBKR_PAPER_SIDECAR_WS=ws://localhost:8090/events

# ─── TradeStation ────────────────────────────────────────────────────
# TS_CLIENT_ID=
# TS_CLIENT_SECRET=
# TS_REFRESH_TOKEN=
# TS_ACCOUNT_ID=
# TS_BASE_URL=https://api.tradestation.com/v3

# ─── Channel Scoping ────────────────────────────────────────────────
# ENABLED_CHANNEL_IDS=                  # comma-separated, empty = all

# ─── AI / Agent ──────────────────────────────────────────────────────
# TRADE_MODEL_PROVIDER=anthropic        # anthropic | xai
# TRADE_MODEL=claude-sonnet-4-6
# AGENT_MAX_TURNS=10
# AGENT_MAX_TOKENS=2048
# XAI_API_KEY=

# ─── Alerts ──────────────────────────────────────────────────────────
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=
# ALERTS_PUSHOVER_ENABLED=1             # set 0 to disable
# DISCORD_WEBHOOK_URL=
# ALERTS_DISCORD_ENABLED=1              # set 0 to disable

# ─── Market Data / Backtest ─────────────────────────────────────────
# DATABENTO_API_KEY=
# DATABENTO_DATASET=DBEQ.BASIC

# ─── Healthcheck ─────────────────────────────────────────────────────
# HEALTHCHECK_ENABLED=1                 # set 0 to disable
# HEALTHCHECK_PING_URL=
