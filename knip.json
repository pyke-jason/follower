{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/eval-orchestrator.ts"]
    },
    "web": {
      "entry": ["src/components/ui/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@eslint/js",
        "eslint-plugin-paths"
      ]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn"
  }
}
