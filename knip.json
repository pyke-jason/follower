{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/db/migrate.ts",
        "src/db/seed.ts",
        "src/local-api/server.ts",
        "src/backtest/launch.ts",
        "src/lib/secrets/manage.ts",
        "scripts/dev-up.ts",
        "scripts/eval-orchestrator.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "web": {
      "entry": [
        "src/main.tsx",
        "src/components/ui/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "shadcn",
        "@eslint/js",
        "eslint-plugin-paths"
      ]
    }
  }
}
